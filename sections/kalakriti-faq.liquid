{% style %}
  #KalakritiFaq-{{ section.id }} {
    --kf-ink: #3d2025;
    --kf-muted: #78676a;
    --kf-accent: #a77a43;
    --kf-line: #e7ddd2;
    --kf-paper: #f8f5f0;
    background: var(--kf-paper);
    color: var(--kf-ink);
    padding: 76px 24px 84px;
  }
  #KalakritiFaq-{{ section.id }} .kf__inner {
    max-width: 980px;
    margin: 0 auto;
  }
  #KalakritiFaq-{{ section.id }} .kf__intro {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 42px;
  }
  #KalakritiFaq-{{ section.id }} .kf__eyebrow {
    color: var(--kf-accent);
    font-size: 11px;
    letter-spacing: .22em;
    font-weight: 700;
    margin: 0 0 14px;
  }
  #KalakritiFaq-{{ section.id }} .kf__heading {
    color: var(--kf-ink);
    font-family: var(--font-heading--family, Georgia, serif);
    font-size: clamp(30px, 4vw, 46px);
    line-height: 1.12;
    font-weight: 500;
    margin: 0;
  }
  #KalakritiFaq-{{ section.id }} .kf__description {
    color: var(--kf-muted);
    font-size: 15px;
    line-height: 1.7;
    margin: 15px 0 0;
  }
  #KalakritiFaq-{{ section.id }} .kf__list {
    border-top: 1px solid var(--kf-line);
  }
  #KalakritiFaq-{{ section.id }} .kf__item {
    border-bottom: 1px solid var(--kf-line);
  }
  #KalakritiFaq-{{ section.id }} .kf__question {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 23px 4px;
    color: var(--kf-ink);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }
  #KalakritiFaq-{{ section.id }} .kf__question::-webkit-details-marker { display: none; }
  #KalakritiFaq-{{ section.id }} .kf__icon {
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    border: 1px solid #d8c6b2;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--kf-accent);
    font-size: 19px;
    font-weight: 400;
    transition: transform .2s ease, background .2s ease;
  }
  #KalakritiFaq-{{ section.id }} .kf__icon::before { content: "+"; }
  #KalakritiFaq-{{ section.id }} details[open] .kf__icon {
    background: #efe5d9;
    transform: rotate(45deg);
  }
  #KalakritiFaq-{{ section.id }} .kf__answer {
    color: var(--kf-muted);
    font-size: 14px;
    line-height: 1.8;
    max-width: 820px;
    padding: 0 54px 24px 4px;
  }
  #KalakritiFaq-{{ section.id }} .kf__answer p { margin: 0; }
  @media (max-width: 600px) {
    #KalakritiFaq-{{ section.id }} { padding: 54px 20px 60px; }
    #KalakritiFaq-{{ section.id }} .kf__intro { margin-bottom: 28px; }
    #KalakritiFaq-{{ section.id }} .kf__question { padding: 19px 2px; font-size: 15px; gap: 14px; }
    #KalakritiFaq-{{ section.id }} .kf__answer { padding: 0 42px 20px 2px; font-size: 13px; }
  }
{% endstyle %}

<section id="KalakritiFaq-{{ section.id }}" aria-labelledby="KalakritiFaqHeading-{{ section.id }}">
  <div class="kf__inner">
    <div class="kf__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="kf__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="kf__heading" id="KalakritiFaqHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="kf__description">{{ section.settings.intro | escape }}</p>
      {% endif %}
    </div>
    <div class="kf__list">
      {% for block in section.blocks %}
        <details class="kf__item" {{ block.shopify_attributes }}>
          <summary class="kf__question">
            <span>{{ block.settings.question | escape }}</span>
            <span class="kf__icon" aria-hidden="true"></span>
          </summary>
          <div class="kf__answer">{{ block.settings.answer }}</div>
        </details>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KALAKRITI FAQ",
  "tag": "section",
  "class": "kalakriti-faq-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE KALAKRITI EDIT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "intro", "label": "Intro text", "default": "A little more about choosing, enjoying and caring for your saree." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Write your answer here.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "KALAKRITI FAQ",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}