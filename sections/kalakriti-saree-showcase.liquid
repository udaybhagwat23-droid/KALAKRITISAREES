{% liquid
  assign background_product = section.settings.background_product
  assign collection_one = section.settings.collection_1
  assign collection_two = section.settings.collection_2
  assign collection_three = section.settings.collection_3
  assign collection_four = section.settings.collection_4
  assign collection_five = section.settings.collection_5
  assign collection_six = section.settings.collection_6
  assign background_image = background_product.featured_image
  if background_product != blank
    for media_item in background_product.media
      if media_item.media_type == 'image'
        assign media_src = media_item.preview_image.src | downcase
        assign media_alt = media_item.alt | downcase
        if media_src contains 'model' or media_alt contains 'mannequin' or media_alt contains 'model view'
          assign background_image = media_item.preview_image
          break
        endif
      endif
    endfor
  endif
%}
<section id="kalakriti-saree-showcase-{{ section.id }}" class="kss-section" style="--kss-bg-image:{% if background_image != blank %}url('{{ background_image | image_url: width: 2200 }}'){% else %}none{% endif %};">
  <div class="kss-shell page-width">
    <div class="kss-intro">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: 1000 | image_tag: class: 'kss-brand-logo', loading: 'lazy', widths: '280, 420, 600, 800, 1000', sizes: '(min-width: 990px) 500px, (min-width: 750px) 380px, 250px', alt: shop.name }}
      {% endif %}
      <span class="kss-eyebrow">{{ section.settings.eyebrow | escape }}</span>
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.description | escape }}</p>
      {% if background_product != blank %}
        <a class="kss-feature-link" href="{{ background_product.url }}">Discover the premium edit <span aria-hidden="true">↗</span></a>
        <span class="kss-feature-name">{{ background_product.title | escape }}</span>
      {% endif %}
    </div>
    <div class="kss-gallery" aria-label="Shop six saree styles">
      {% assign saree_slots = 'one,two,three,four,five,six' | split: ',' %}
      {% for slot in saree_slots %}
        {% case slot %}
          {% when 'one' %}{% assign card_product = section.settings.product_1 %}{% assign card_label = section.settings.label_1 %}{% assign card_collection = collection_one %}
          {% when 'two' %}{% assign card_product = section.settings.product_2 %}{% assign card_label = section.settings.label_2 %}{% assign card_collection = collection_two %}
          {% when 'three' %}{% assign card_product = section.settings.product_3 %}{% assign card_label = section.settings.label_3 %}{% assign card_collection = collection_three %}
          {% when 'four' %}{% assign card_product = section.settings.product_4 %}{% assign card_label = section.settings.label_4 %}{% assign card_collection = collection_four %}
          {% when 'five' %}{% assign card_product = section.settings.product_5 %}{% assign card_label = section.settings.label_5 %}{% assign card_collection = collection_five %}
          {% when 'six' %}{% assign card_product = section.settings.product_6 %}{% assign card_label = section.settings.label_6 %}{% assign card_collection = collection_six %}
        {% endcase %}
        {% if card_product != blank and card_collection != blank %}
          {% assign card_image = card_product.featured_image %}
          {% for media_item in card_product.media %}
            {% if media_item.media_type == 'image' %}
              {% assign media_src = media_item.preview_image.src | downcase %}
              {% assign media_alt = media_item.alt | downcase %}
              {% if media_src contains 'model' or media_alt contains 'mannequin' or media_alt contains 'model view' %}
                {% assign card_image = media_item.preview_image %}
                {% break %}
              {% endif %}
            {% endif %}
          {% endfor %}
          <a class="kss-card" href="{{ card_collection.url }}" aria-label="View all {{ card_label | escape }} sarees">
            <span class="kss-card-image">
              {% if card_image != blank %}
                {{ card_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 990px) 18vw, (min-width: 750px) 30vw, 45vw', alt: card_product.title }}
              {% else %}
                <span class="kss-image-fallback">K</span>
              {% endif %}
            </span>
            <span class="kss-card-copy">
              <span class="kss-card-label">{{ card_label | escape }}</span>
              <strong>{{ card_product.title | escape }}</strong>
              <span class="kss-card-cta">Explore collection <span aria-hidden="true">→</span></span>
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% style %}
#kalakriti-saree-showcase-{{ section.id }}{position:relative;isolation:isolate;overflow:hidden;padding:clamp(34px,5vw,68px) 0;background-color:#f4e7cf;background-image:linear-gradient(90deg,rgba(35,8,19,.48) 0%,rgba(35,8,19,.38) 31%,rgba(245,234,214,.58) 54%,rgba(245,234,214,.78) 100%),var(--kss-bg-image);background-position:center left;background-size:cover;color:#541c2a}
#kalakriti-saree-showcase-{{ section.id }} .kss-shell{display:grid;grid-template-columns:minmax(250px,.58fr) minmax(0,1.42fr);gap:clamp(34px,5vw,76px);align-items:center;max-width:1640px}
#kalakriti-saree-showcase-{{ section.id }} .kss-intro{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;min-height:440px;padding:clamp(18px,2vw,32px);color:#fff1d8;text-shadow:0 2px 12px #210d17a6}
#kalakriti-saree-showcase-{{ section.id }} .kss-brand-logo{display:block;width:clamp(280px,29vw,380px);height:auto;max-height:165px;object-fit:contain;object-position:left center;margin:-20px 0 16px;mix-blend-mode:normal;filter:brightness(1.3) contrast(1.18) drop-shadow(0 4px 12px #160711a0)}
#kalakriti-saree-showcase-{{ section.id }} .kss-eyebrow{font-size:.72rem;font-weight:700;letter-spacing:.24em;text-transform:uppercase;color:#f4d99e}
#kalakriti-saree-showcase-{{ section.id }} .kss-intro h2{max-width:440px;margin:14px 0 12px;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2.1rem,3.6vw,4rem);font-weight:600;line-height:1.04;color:#fff1d8}
#kalakriti-saree-showcase-{{ section.id }} .kss-intro p{max-width:360px;margin:0;color:#fff0d6;font-size:1rem;line-height:1.65}
#kalakriti-saree-showcase-{{ section.id }} .kss-feature-link{display:inline-flex;align-items:center;gap:9px;margin-top:25px;padding:11px 17px;border:1px solid #e2c17d;border-radius:999px;background:#5c1729;color:#fff1d8;text-decoration:none;font-size:.82rem;font-weight:700;letter-spacing:.04em}
#kalakriti-saree-showcase-{{ section.id }} .kss-feature-link:focus-visible,#kalakriti-saree-showcase-{{ section.id }} .kss-card:focus-visible{outline:3px solid #b17b2b;outline-offset:4px}
#kalakriti-saree-showcase-{{ section.id }} .kss-feature-name{max-width:340px;margin-top:10px;color:#f4dfba;font-family:Georgia,'Times New Roman',serif;font-size:.86rem;font-style:italic;line-height:1.4}
#kalakriti-saree-showcase-{{ section.id }} .kss-gallery{display:grid;width:100%;max-width:none;justify-self:end;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(10px,1.2vw,18px);align-items:stretch}
@media(min-width:990px){#kalakriti-saree-showcase-{{ section.id }} .kss-gallery{width:calc(100% + clamp(24px,3.5vw,56px));margin-inline-end:calc(-1 * clamp(24px,3.5vw,56px))}}
@media(min-width:990px){#kalakriti-saree-showcase-{{ section.id }} .kss-shell{grid-template-columns:minmax(340px,.72fr) minmax(0,1.28fr)}#kalakriti-saree-showcase-{{ section.id }} .kss-brand-logo{width:clamp(360px,33vw,500px);max-height:220px;margin:-24px 0 18px;mix-blend-mode:normal;filter:brightness(1.3) contrast(1.18) drop-shadow(0 4px 12px #160711a0)}}
#kalakriti-saree-showcase-{{ section.id }} .kss-card{display:flex;min-width:0;flex-direction:column;overflow:hidden;border:1px solid #c39a58;border-radius:18px;background:linear-gradient(180deg,#fff8e9,#f0dfbd);box-shadow:0 7px 20px #44251c24;color:#541c2a;text-decoration:none;transition:transform .22s ease,box-shadow .22s ease}
#kalakriti-saree-showcase-{{ section.id }} .kss-card:hover{transform:translateY(-4px);box-shadow:0 12px 26px #44251c38}
#kalakriti-saree-showcase-{{ section.id }} .kss-card-image{display:block;overflow:hidden;aspect-ratio:4/5;background:#e7d6b8}
#kalakriti-saree-showcase-{{ section.id }} .kss-card-image img{display:block;width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .35s ease}
#kalakriti-saree-showcase-{{ section.id }} .kss-card:hover .kss-card-image img{transform:scale(1.035)}
#kalakriti-saree-showcase-{{ section.id }} .kss-image-fallback{display:grid;width:100%;height:100%;place-items:center;color:#7b2636;font-family:Georgia,serif;font-size:3rem}
#kalakriti-saree-showcase-{{ section.id }} .kss-card-copy{display:flex;flex:1;flex-direction:column;align-items:flex-start;padding:11px 12px 13px}
#kalakriti-saree-showcase-{{ section.id }} .kss-card-label{margin-bottom:5px;color:#9a702e;font-size:.65rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
#kalakriti-saree-showcase-{{ section.id }} .kss-card-copy strong{display:-webkit-box;overflow:hidden;min-height:2.5em;color:#5a1c2b;font-family:Georgia,'Times New Roman',serif;font-size:clamp(.82rem,1vw,1rem);font-weight:700;line-height:1.25;-webkit-box-orient:vertical;-webkit-line-clamp:2}
@media(max-width:989px){#kalakriti-saree-showcase-{{ section.id }} .kss-shell{grid-template-columns:minmax(170px,.34fr) minmax(0,1.66fr);gap:18px}#kalakriti-saree-showcase-{{ section.id }} .kss-intro{min-height:380px;padding:10px}#kalakriti-saree-showcase-{{ section.id }} .kss-gallery{gap:9px}#kalakriti-saree-showcase-{{ section.id }} .kss-card-copy{padding:9px 8px 10px}}
@media(prefers-reduced-motion:reduce){#kalakriti-saree-showcase-{{ section.id }} .kss-card,#kalakriti-saree-showcase-{{ section.id }} .kss-card-image img{transition:none}}
{% endstyle %}
{% style %}
@media screen and (max-width: 749px) {
  #kalakriti-saree-showcase-{{ section.id }} { padding: 24px 0 30px; background-image: linear-gradient(180deg, rgb(35 8 19 / 76%) 0%, rgb(35 8 19 / 58%) 42%, rgb(245 234 214 / 18%) 100%), var(--kss-bg-image); background-position: center; background-size: cover; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-shell { display: flex; flex-direction: column; align-items: stretch; gap: 18px; padding-inline: 14px; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-intro { width: 100%; min-height: 0; align-items: center; padding: 8px 8px 2px; text-align: center; color: #fff1d8; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-brand-logo { width: min(68vw, 250px); max-height: 92px; object-position: center; margin: 0 auto 10px; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-eyebrow { color: #f4d99e; font-size: .62rem; letter-spacing: .17em; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-intro h2 { max-width: 340px; margin: 9px auto 8px; color: #fff1d8; font-size: clamp(1.85rem, 8vw, 2.35rem); line-height: 1.08; text-wrap: balance; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-intro p { max-width: 340px; margin-inline: auto; color: #fff0d6; font-size: .88rem; line-height: 1.5; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-feature-link { margin-top: 14px; padding: 10px 15px; font-size: .76rem; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-feature-name { margin-top: 7px; color: #f4dfba; font-size: .78rem; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-gallery { display: flex; width: 100%; max-width: none; justify-self: auto; gap: 12px; overflow-x: auto; overflow-y: hidden; padding: 2px 2px 14px; scroll-snap-type: x mandatory; scroll-padding-inline: 2px; overscroll-behavior-inline: contain; scrollbar-width: thin; scrollbar-color: #b88a4b #fff0d8; -webkit-overflow-scrolling: touch; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-card { flex: 0 0 min(72vw, 270px); max-width: 270px; scroll-snap-align: start; border-radius: 15px; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-card-image { aspect-ratio: 4 / 5; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-card-copy { padding: 10px 11px 12px; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-card-copy strong { font-size: .9rem; }
  #kalakriti-saree-showcase-{{ section.id }} .kss-card-cta { font-size: .75rem; }
}
{% endstyle %}
{% schema %}
{
  "name": "KALAKRITI saree showcase",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE KALAKRITI SIGNATURE EDIT"},
    {"type":"text","id":"heading","label":"Heading","default":"A Saree for Every Story"},
    {"type":"textarea","id":"description","label":"Description","default":"Discover six signature saree styles, each styled with its own mannequin look from our collection."},
    {"type":"product","id":"background_product","label":"Premium background saree"},
    {"type":"collection","id":"collection_1","label":"Card 1 collection — Banarasi"},
    {"type":"product","id":"product_1","label":"Card 1 — Banarasi"},
    {"type":"text","id":"label_1","label":"Card 1 style label","default":"Banarasi"},
    {"type":"collection","id":"collection_2","label":"Card 2 collection — Kanjivaram"},
    {"type":"product","id":"product_2","label":"Card 2 — Kanjivaram"},
    {"type":"text","id":"label_2","label":"Card 2 style label","default":"Kanjivaram"},
    {"type":"collection","id":"collection_3","label":"Card 3 collection — Paithani"},
    {"type":"product","id":"product_3","label":"Card 3 — Paithani"},
    {"type":"text","id":"label_3","label":"Card 3 style label","default":"Paithani"},
    {"type":"collection","id":"collection_4","label":"Card 4 collection — Narayan Peth"},
    {"type":"product","id":"product_4","label":"Card 4 — Narayan Peth"},
    {"type":"text","id":"label_4","label":"Card 4 style label","default":"Narayan Peth"},
    {"type":"collection","id":"collection_5","label":"Card 5 collection — Gopuram"},
    {"type":"product","id":"product_5","label":"Card 5 — Gopuram"},
    {"type":"text","id":"label_5","label":"Card 5 style label","default":"Gopuram"},
    {"type":"collection","id":"collection_6","label":"Card 6 collection — Sico"},
    {"type":"product","id":"product_6","label":"Card 6 — Sico"},
    {"type":"text","id":"label_6","label":"Card 6 style label","default":"Sico"}
  ],
  "presets": [{"name":"KALAKRITI saree showcase"}]
}
{% endschema %}
