{% liquid
  assign best_products = 'one,two,three,four,five,six,seven,eight' | split: ','
%}
<section id="kalakriti-best-{{ section.id }}" class="kbc-section">
  <div class="kbc-shell page-width">
    <div class="kbc-heading-row">
      <header class="kbc-heading">
        {% if section.settings.eyebrow != blank %}<span class="kbc-eyebrow">{{ section.settings.eyebrow | escape }}</span>{% endif %}
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.description != blank %}<p>{{ section.settings.description | escape }}</p>{% endif %}
      </header>
      <div class="kbc-controls" aria-label="{{ section.settings.heading | escape }} navigation">
        <button class="kbc-arrow kbc-prev" type="button" aria-label="{{ section.settings.previous_label | escape }}" aria-controls="kbc-track-{{ section.id }}" data-kbc-prev disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="kbc-arrow kbc-next" type="button" aria-label="{{ section.settings.next_label | escape }}" aria-controls="kbc-track-{{ section.id }}" data-kbc-next>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </div>
    <div id="kbc-track-{{ section.id }}" class="kbc-track" data-kbc-track role="list" tabindex="0" aria-label="{{ section.settings.heading | escape }}">
      {% for slot in best_products %}
        {% case slot %}
          {% when 'one' %}{% assign selected_product = section.settings.product_1 %}
          {% when 'two' %}{% assign selected_product = section.settings.product_2 %}
          {% when 'three' %}{% assign selected_product = section.settings.product_3 %}
          {% when 'four' %}{% assign selected_product = section.settings.product_4 %}
          {% when 'five' %}{% assign selected_product = section.settings.product_5 %}
          {% when 'six' %}{% assign selected_product = section.settings.product_6 %}
          {% when 'seven' %}{% assign selected_product = section.settings.product_7 %}
          {% when 'eight' %}{% assign selected_product = section.settings.product_8 %}
        {% endcase %}
        {% if selected_product != blank and selected_product.price <= 2500000 %}
          <article class="kbc-product" role="listitem">
            <a class="kbc-product-link" href="{{ selected_product.url }}" aria-label="{{ selected_product.title | escape }}">
              <div class="kbc-product-image">
                {% if selected_product.featured_image != blank %}
                  {{ selected_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 23vw, (min-width: 750px) 34vw, 78vw', alt: selected_product.featured_image.alt | default: selected_product.title }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'kbc-product-placeholder' }}
                {% endif %}
              </div>
              <div class="kbc-product-info">
                <h3>{{ selected_product.title | escape }}</h3>
                <div class="kbc-product-price">
                  {% if selected_product.compare_at_price > selected_product.price %}
                    <span class="kbc-sale-price">{{ selected_product.price | money }}</span>
                    <s>{{ selected_product.compare_at_price | money }}</s>
                  {% else %}
                    <span>{{ selected_product.price | money }}</span>
                  {% endif %}
                </div>
              </div>
            </a>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% style %}
#kalakriti-best-{{ section.id }}{padding:clamp(38px,5vw,68px) 0;background:transparent;color:var(--color-foreground)}
#kalakriti-best-{{ section.id }} .kbc-shell{max-width:1600px}
#kalakriti-best-{{ section.id }} .kbc-heading-row{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:0 0 clamp(20px,2.8vw,32px)}
#kalakriti-best-{{ section.id }} .kbc-heading{min-width:0}
#kalakriti-best-{{ section.id }} .kbc-eyebrow{display:block;margin-bottom:8px;color:#98702e;font-size:.7rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase}
#kalakriti-best-{{ section.id }} .kbc-heading h2{margin:0;color:var(--color-foreground);font-family:Georgia,'Times New Roman',serif;font-size:clamp(1.8rem,3vw,2.7rem);line-height:1.12}
#kalakriti-best-{{ section.id }} .kbc-heading p{margin:9px 0 0;color:var(--color-foreground);opacity:.78;font-size:.95rem;line-height:1.55}
#kalakriti-best-{{ section.id }} .kbc-controls{display:flex;flex:0 0 auto;gap:9px}
#kalakriti-best-{{ section.id }} .kbc-arrow{display:grid;place-items:center;width:42px;height:42px;padding:0;border:1px solid rgb(var(--color-foreground-rgb)/.22);border-radius:50%;background:var(--color-background);color:var(--color-foreground);cursor:pointer;transition:background-color .15s cubic-bezier(.16,1,.3,1),color .15s cubic-bezier(.16,1,.3,1),transform .15s cubic-bezier(.16,1,.3,1)}
#kalakriti-best-{{ section.id }} .kbc-arrow svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
#kalakriti-best-{{ section.id }} .kbc-arrow:hover:not(:disabled){background:var(--color-foreground);color:var(--color-background)}
#kalakriti-best-{{ section.id }} .kbc-arrow:active:not(:disabled){transform:scale(.94)}
#kalakriti-best-{{ section.id }} .kbc-arrow:disabled{opacity:.32;cursor:not-allowed}
#kalakriti-best-{{ section.id }} .kbc-arrow:focus-visible,#kalakriti-best-{{ section.id }} .kbc-track:focus-visible{outline:3px solid #956b2d;outline-offset:3px}
#kalakriti-best-{{ section.id }} .kbc-track{display:flex;gap:clamp(14px,1.7vw,24px);overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;padding:0 2px 12px;overscroll-behavior-inline:contain}
#kalakriti-best-{{ section.id }} .kbc-track::-webkit-scrollbar{display:none}
#kalakriti-best-{{ section.id }} .kbc-product{flex:0 0 calc((100% - 3 * clamp(14px,1.7vw,24px))/4);min-width:0;scroll-snap-align:start}
#kalakriti-best-{{ section.id }} .kbc-product-link{display:block;color:inherit;text-decoration:none}
#kalakriti-best-{{ section.id }} .kbc-product-image{overflow:hidden;aspect-ratio:4/5;border-radius:14px;background:rgb(var(--color-foreground-rgb)/.05)}
#kalakriti-best-{{ section.id }} .kbc-product-image img,#kalakriti-best-{{ section.id }} .kbc-product-placeholder{display:block;width:100%;height:100%;object-fit:cover;object-position:center 24%;transition:transform .3s cubic-bezier(.16,1,.3,1)}
#kalakriti-best-{{ section.id }} .kbc-product-link:hover .kbc-product-image img{transform:scale(1.035)}
#kalakriti-best-{{ section.id }} .kbc-product-info{padding:11px 2px 2px}
#kalakriti-best-{{ section.id }} .kbc-product-info h3{margin:0;color:var(--color-foreground);font-size:.94rem;font-weight:500;line-height:1.4}
#kalakriti-best-{{ section.id }} .kbc-product-price{display:flex;gap:9px;align-items:center;margin-top:6px;font-size:.92rem;font-weight:600}
#kalakriti-best-{{ section.id }} .kbc-product-price s{font-size:.82rem;font-weight:400;opacity:.58}
#kalakriti-best-{{ section.id }} .kbc-sale-price{color:#9b2638}
#kalakriti-best-{{ section.id }} .kbc-product-link:focus-visible{outline:3px solid #956b2d;outline-offset:4px;border-radius:14px}
@media(max-width:749px){#kalakriti-best-{{ section.id }} .kbc-heading-row{align-items:flex-end}#kalakriti-best-{{ section.id }} .kbc-product{flex-basis:min(72vw,290px)}#kalakriti-best-{{ section.id }} .kbc-arrow{width:38px;height:38px}}
@media(prefers-reduced-motion:reduce){#kalakriti-best-{{ section.id }} .kbc-track{scroll-behavior:auto}#kalakriti-best-{{ section.id }} .kbc-product-image img{transition:none}}
{% endstyle %}
<script>
(() => {
  const section = document.getElementById('kalakriti-best-{{ section.id }}');
  if (!section || section.dataset.sliderReady === 'true') return;
  const track = section.querySelector('[data-kbc-track]');
  const previous = section.querySelector('[data-kbc-prev]');
  const next = section.querySelector('[data-kbc-next]');
  if (!track || !previous || !next) return;
  section.dataset.sliderReady = 'true';
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const updateControls = () => {
    const maxScroll = track.scrollWidth - track.clientWidth;
    previous.disabled = track.scrollLeft <= 2;
    next.disabled = track.scrollLeft >= maxScroll - 2;
  };
  const scrollByPage = (direction) => track.scrollBy({ left: direction * track.clientWidth * 0.85, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
  previous.addEventListener('click', () => scrollByPage(-1));
  next.addEventListener('click', () => scrollByPage(1));
  track.addEventListener('scroll', updateControls, { passive: true });
  window.addEventListener('resize', updateControls, { passive: true });
  updateControls();
})();
</script>
{% style %}
@media screen and (max-width: 749px) {
  #kalakriti-best-{{ section.id }} { padding: 28px 0 34px; }
  #kalakriti-best-{{ section.id }} .kbc-shell { padding-inline: 14px; }
  #kalakriti-best-{{ section.id }} .kbc-heading-row { align-items: center; gap: 10px; margin-bottom: 16px; }
  #kalakriti-best-{{ section.id }} .kbc-heading h2 { font-size: clamp(1.55rem, 7vw, 1.85rem); line-height: 1.12; }
  #kalakriti-best-{{ section.id }} .kbc-heading p { max-width: 34ch; font-size: .82rem; line-height: 1.45; }
  #kalakriti-best-{{ section.id }} .kbc-product { flex-basis: min(76vw, 292px); }
  #kalakriti-best-{{ section.id }} .kbc-track { gap: 12px; padding-bottom: 12px; scroll-padding-inline: 2px; scrollbar-width: thin; scrollbar-color: #b88a4b transparent; }
  #kalakriti-best-{{ section.id }} .kbc-arrow { width: 36px; height: 36px; }
  #kalakriti-best-{{ section.id }} .kbc-product-info h3 { font-size: .9rem; line-height: 1.38; }
  #kalakriti-best-{{ section.id }} .kbc-product-price { font-size: .88rem; }
}
{% endstyle %}
{% schema %}
{
  "name": "KALAKRITI best collection",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"HANDPICKED PREMIUM SAREES"},
    {"type":"text","id":"heading","label":"Heading","default":"Our Best Collection"},
    {"type":"textarea","id":"description","label":"Description","default":"Eight standout sarees, chosen for their exceptional colour, artistry and traditional detail."},
    {"type":"product","id":"product_1","label":"Premium saree 1"},
    {"type":"product","id":"product_2","label":"Premium saree 2"},
    {"type":"product","id":"product_3","label":"Premium saree 3"},
    {"type":"product","id":"product_4","label":"Premium saree 4"},
    {"type":"product","id":"product_5","label":"Premium saree 5"},
    {"type":"product","id":"product_6","label":"Premium saree 6"},
    {"type":"product","id":"product_7","label":"Premium saree 7"},
    {"type":"product","id":"product_8","label":"Premium saree 8"},
    {"type":"text","id":"previous_label","label":"Previous button accessibility label","default":"Previous products"},
    {"type":"text","id":"next_label","label":"Next button accessibility label","default":"Next products"}
  ],
  "presets":[{"name":"KALAKRITI best collection"}]
}
{% endschema %}
