ding-block-end":16}},"kalakriti_faq":{"type":"kalakriti-faq","blocks":{"faq_authenticity":{"type":"faq","settings":{"question":"How can I know more about a saree's authenticity?","answer":"<p>For this demo storefront, product details are illustrative. Before a real purchase, check the individual product description for its weave, material, origin and artisan details. Only verified information should be used to describe a saree as authentic or handwoven.<\/p>"}},"faq_handwoven":{"type":"faq","settings":{"question":"Are all the sarees handwoven?","answer":"<p>This demo does not make a blanket handwoven claim. In a live store, the weaving technique should be confirmed for each product and clearly mentioned on its product page.<\/p>"}},"faq_colour":{"type":"faq","settings":{"question":"Will the saree colour look exactly the same in person?","answer":"<p>Colours can appear slightly different across screens because of display settings and lighting. Use the product photographs and description as a guide; for a live store, include accurate images in natural lighting.<\/p>"}},"faq_care":{"type":"faq","settings":{"question":"How should I care for my Paithani saree?","answer":"<p>As a general precaution, store a silk saree in a clean, dry place, avoid prolonged direct sunlight and follow the care instructions supplied with the specific garment. When in doubt, consult a professional saree or textile cleaner.<\/p>"}},"faq_shipping":{"type":"faq","settings":{"question":"How long does delivery take?","answer":"<p>Delivery timelines have not been configured for this demo project. In a live store, the estimated dispatch and delivery time should be shown at checkout or in the shipping policy, based on the customer's location.<\/p>"}},"faq_returns":{"type":"faq","settings":{"question":"Can I return or exchange a saree?","answer":"<p>A return and exchange policy has not been configured for this demo storefront. Before launch, publish a clear policy covering eligibility, time limits, product condition and the process for requesting a return or exchange.<\/p>"}}},"block_order":["faq_authenticity","faq_handwoven","faq_colour","faq_care","faq_shipping","faq_returns"],"name":"KALAKRITI FAQ","settings":{"eyebrow":"THE KALAKRITI EDIT","heading":"Frequently Asked Questions","intro":"A little more about choosing, enjoying and caring for your saree."}},"17947288392d7676f8":{"type":"_blocks","settings":{"content_direction":"column","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","section_height":"","section_height_custom":50,"background_media":"none","background_color":"","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","border":"none","border_width":1,"border_opacity":100,"border_color":"","border_radius":0,"padding-block-start":0,"padding-block-end":0}}},"order":["hero_jVaWmY","kalakriti_price_cards","kalakriti_saree_showcase","product_list_fa6P9H","product_list_LPD43K","product_list_KHnLnX","kalakriti_faq","17947288392d7676f8"]}