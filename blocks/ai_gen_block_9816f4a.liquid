{% doc %}
  @prompt
    a hero banner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.height }}px;
    overflow: hidden;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }
  .ai-hero-{{ ai_gen_id }}__media,
  .ai-hero-{{ ai_gen_id }}__overlay {
    position: absolute;
    inset: 0;
  }
  .ai-hero-{{ ai_gen_id }}__media img,
  .ai-hero-{{ ai_gen_id }}__placeholder,
  .ai-hero-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ai-hero-{{ ai_gen_id }}__media img { object-fit: cover; }
  .ai-hero-{{ ai_gen_id }}__placeholder { background: #eee9e1; }
  .ai-hero-{{ ai_gen_id }}__placeholder svg { object-fit: cover; }
  .ai-hero-{{ ai_gen_id }}__overlay { background: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}); }
  .ai-hero-{{ ai_gen_id }}__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(28px, 7vw, 88px);
    max-width: 760px;
  }
  .ai-hero-{{ ai_gen_id }}__eyebrow { margin: 0 0 12px; font-size: 0.875rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .ai-hero-{{ ai_gen_id }}__heading { margin: 0; font-size: clamp(2rem, 5vw, 4.5rem); line-height: 1.05; }
  .ai-hero-{{ ai_gen_id }}__text { margin: 18px 0 0; line-height: 1.6; }
  .ai-hero-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 26px;
    min-height: 48px;
    padding: 12px 24px;
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-weight: 600;
    text-decoration: none;
  }
  .ai-hero-{{ ai_gen_id }}__button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .ai-hero-{{ ai_gen_id }} { min-height: {{ block.settings.mobile_height }}px; }
    .ai-hero-{{ ai_gen_id }}__content { padding: 28px 22px; }
    .ai-hero-{{ ai_gen_id }}__heading { font-size: clamp(2rem, 10vw, 3.25rem); }
  }
{% endstyle %}

<div class="ai-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-{{ ai_gen_id }}__media">
    {% if block.settings.image %}
      <img src="{{ block.settings.image | image_url: width: 2400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
    {% else %}
      <div class="ai-hero-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </div>
  <div class="ai-hero-{{ ai_gen_id }}__overlay"></div>
  <div class="ai-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h1 class="ai-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h1>{% endif %}
    {% if block.settings.description != blank %}<div class="ai-hero-{{ ai_gen_id }}__text">{{ block.settings.description }}</div>{% endif %}
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-hero-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 300, "max": 800, "step": 50, "unit": "px", "default": 550 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 250, "max": 650, "step": 50, "unit": "px", "default": 450 },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A collection to love" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover something beautiful" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Thoughtfully chosen pieces for every occasion.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background_color", "label": "Fallback background", "default": "#eee9e1" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "range", "id": "overlay_opacity", "label": "Image overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#000000" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 }
  ],
  "presets": [{ "name": "Hero banner" }],
  "tag": null,
  "class": "hero-banner-block"
}
{% endschema %}