{% doc %}
  @prompt
    Create a new section directly below the existing KALAKRITI Showcase, with the heading “Our Premium Collection”. Match the store’s existing styling, spacing and responsive layout. Under the heading, feature only the existing product Black Pochampalli Pure Silk Ikat Saree with Unstitched Blouse Piece (gid://shopify/Product/15505387552955), showing its current main image, product title, current price and a link to its product page. Use an editable product picker and editable heading so the merchant can change them later. Do not create a new product or change any existing product details. Keep all other sections unchanged.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-premium-collection-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 48px 24px;
    color: rgb(var(--color-foreground, 0 0 0));
  }

  .ai-premium-collection__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-premium-collection__heading-{{ ai_gen_id }} {
    margin: 0 0 32px;
    text-align: center;
    font-family: var(--font-heading--family, inherit);
    font-size: clamp(28px, 4vw, 48px);
    line-height: 1.15;
    font-weight: 600;
  }

  .ai-premium-collection__card-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .ai-premium-collection__image-wrap-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background: #f5f5f5;
    border-radius: var(--product-corner-radius, 0px);
  }

  .ai-premium-collection__image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .ai-premium-collection__placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: #333333;
  }

  .ai-premium-collection__placeholder-{{ ai_gen_id }} svg {
    width: 70%;
    height: 70%;
    color: #777777;
  }

  .ai-premium-collection__empty-{{ ai_gen_id }} {
    position: absolute;
    bottom: 14px;
    left: 12px;
    right: 12px;
    text-align: center;
    font-size: 14px;
  }

  .ai-premium-collection__details-{{ ai_gen_id }} {
    padding-top: 16px;
    text-align: center;
  }

  .ai-premium-collection__title-{{ ai_gen_id }} {
    display: block;
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 500;
  }

  .ai-premium-collection__price-{{ ai_gen_id }} {
    display: block;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-premium-collection-{{ ai_gen_id }} a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .ai-premium-collection__card-{{ ai_gen_id }} {
      max-width: 520px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-premium-collection-{{ ai_gen_id }} {
      padding: 32px 16px;
    }

    .ai-premium-collection__heading-{{ ai_gen_id }} {
      margin-bottom: 24px;
    }
  }
{% endstyle %}

<section class="ai-premium-collection-{{ ai_gen_id }}" style="width: 100%;" {{ block.shopify_attributes }}>
  <div class="ai-premium-collection__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-premium-collection__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}
    {% assign featured_product = block.settings.featured_product %}
    {% if featured_product != blank %}
      <a class="ai-premium-collection__card-{{ ai_gen_id }}" href="{{ featured_product.url }}" aria-label="{{ featured_product.title | escape }}">
        <div class="ai-premium-collection__image-wrap-{{ ai_gen_id }}">
          {% if featured_product.featured_image %}
            <img class="ai-premium-collection__image-{{ ai_gen_id }}" src="{{ featured_product.featured_image | image_url: width: 1200 }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}" loading="lazy" width="{{ featured_product.featured_image.width }}" height="{{ featured_product.featured_image.height }}">
          {% else %}
            <div class="ai-premium-collection__placeholder-{{ ai_gen_id }}">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
              <span class="ai-premium-collection__empty-{{ ai_gen_id }}">Choose a product with a featured image</span>
            </div>
          {% endif %}
        </div>
        <div class="ai-premium-collection__details-{{ ai_gen_id }}">
          <span class="ai-premium-collection__title-{{ ai_gen_id }}">{{ featured_product.title | escape }}</span>
          <span class="ai-premium-collection__price-{{ ai_gen_id }}">{{ featured_product.price | money }}</span>
        </div>
      </a>
    {% else %}
      <div class="ai-premium-collection__card-{{ ai_gen_id }}" aria-live="polite">
        <div class="ai-premium-collection__image-wrap-{{ ai_gen_id }}">
          <div class="ai-premium-collection__placeholder-{{ ai_gen_id }}">
            {{ 'product-apparel-1' | placeholder_svg_tag }}
            <span class="ai-premium-collection__empty-{{ ai_gen_id }}">Select the premium saree product in block settings</span>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Premium collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Premium Collection"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Premium collection"
    }
  ],
  "tag": null,
  "class": "premium-collection-block"
}
{% endschema %}